{
  "version": 2,
  "description": "Primary exact-score mechanism benchmark. M5 is exactly M3, so no duplicate run. No checkpoint or truth enters search.",
  "defaults": {
    "study": "exact_mechanisms",
    "budget": {
      "tolerance": 19
    }
  },
  "grid": {
    "problem.dim": [
      10,
      30,
      50
    ],
    "problem.family": [
      "close",
      "overlap",
      "rare",
      "many",
      "anisotropic",
      "uneven",
      "sheared",
      "collinear_gmm"
    ],
    "distribution_seed": [
      0,
      1,
      2
    ],
    "seed": [
      0,
      1
    ],
    "budget.limit": [
      2048,
      8192
    ]
  },
  "variants": [
    {
      "label": "M1_ddim",
      "config": {
        "method": {
          "name": "sampling",
          "refill": "none"
        }
      }
    },
    {
      "label": "M2_single",
      "config": {
        "method": {
          "levels": [
            0
          ],
          "steps": 45
        }
      }
    },
    {
      "label": "M3_multi",
      "config": {
        "method": {}
      }
    },
    {
      "label": "M4_merge",
      "config": {
        "method": {
          "merge": {
            "when": "every",
            "radius": 0.25,
            "radius_factor": 0.8,
            "representative": "mean"
          }
        }
      }
    },
    {
      "label": "M6_split_v2",
      "config": {
        "method": {
          "split": {
            "kind": "v2"
          }
        }
      }
    },
    {
      "label": "split_v3f1_original_kernel",
      "config": {
        "method": {
          "split": {
            "kind": "v3f1"
          }
        }
      }
    },
    {
      "label": "M7_extra_starts",
      "config": {
        "method": {
          "refill": "restarts"
        }
      }
    },
    {
      "label": "M8_merge_restarts",
      "config": {
        "method": {
          "refill": "restarts",
          "merge": {
            "when": "every",
            "radius": 0.25,
            "radius_factor": 0.8,
            "representative": "mean"
          }
        }
      }
    }
  ],
  "contrasts": [
    {
      "id": "single_vs_multi",
      "left": "M2_single",
      "right": "M3_multi",
      "metrics": [
        "one_to_one_recall",
        "rare_recall",
        "soft_error",
        "K",
        "queries"
      ],
      "pairing": "starts",
      "primary_filters": {
        "family": [
          "rare",
          "close"
        ],
        "output_policy": [
          "le8"
        ],
        "budget": [
          8192
        ],
        "radius": [
          0.25
        ]
      },
      "primary_metrics": [
        "one_to_one_recall",
        "rare_recall"
      ]
    },
    {
